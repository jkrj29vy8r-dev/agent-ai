# Copiază în .env.local și completează. .env.local nu se pune în git.
# Valorile: Supabase Dashboard → Project Settings → API Keys
# (local: `npm run db:start` le afișează).

# Publice: ajung și în browser. Sunt sigure doar pentru că RLS e activ peste tot.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secretă: DOAR pe server (backend-ul agentului). Ocolește RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# Claude (agentul și rezumatele). DOAR pe server.
ANTHROPIC_API_KEY=sk-ant-...
